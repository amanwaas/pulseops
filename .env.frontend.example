# ==============================================================================
# PulseOps Frontend Environment Configuration (.env.example)
# Copy this file to frontend/.env and replace with your backend endpoints.
# ==============================================================================

# Backend API REST base URL (Render persistent web service)
VITE_API_URL=https://your-pulseops-backend.onrender.com/api/v1

# Backend Real-time WebSocket base URL (Render persistent web service)
VITE_WS_URL=wss://your-pulseops-backend.onrender.com/api/v1/ws/live
