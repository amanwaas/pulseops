# ==============================================================================
# PulseOps Backend Environment Configuration (.env.example)
# Copy this file to backend/.env and replace placeholders with your actual values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

PROJECT_NAME="PulseOps Monitoring Platform"
ENVIRONMENT="production"
VERSION="1.0.0"

# ------------------------------------------------------------------------------
# Neon PostgreSQL 16 (Serverless Database)
# ------------------------------------------------------------------------------
# For production, use Neon's Pooled connection string (-pooler endpoint):
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Connection Pooling Tuning for Neon PgBouncer
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_PRE_PING=True

# ------------------------------------------------------------------------------
# Security, HMAC & Encryption Keys (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal key used to encrypt webhook secrets and alert destinations at rest
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here_64_characters

# JWT Authentication Secret
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_jwt_secret_key_here_generate_with_secrets
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS Allowed Domains (Explicit for Vercel production and preview)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app,https://*.vercel.app

# ------------------------------------------------------------------------------
# Health Check Engine & Retention
# ------------------------------------------------------------------------------
HEALTH_CHECK_DEFAULT_INTERVAL_SECONDS=60
HEALTH_CHECK_DEFAULT_TIMEOUT_SECONDS=5
CONSECUTIVE_FAILURES_THRESHOLD=3
LATENCY_SPIKE_THRESHOLD_MS=1500.0
RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# Alerting SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_or_smtp_password
SMTP_FROM=alerts@yourdomain.com
